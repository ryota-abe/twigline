    "viewsContainers": {
      "activitybar": [
        {
          "id": "twigline",
          "title": "Twigline",
          "icon": "media/twigline.svg"
        }
      ]
    },
    "views": {
      "twigline": [
        {
          "id": "twigline.repositories",
          "name": "%view.repositories%",
          "icon": "media/twigline.svg"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "twigline.repositories",
        "contents": "%view.repositories.welcome%"
      }
    ],
    "menus": {
      "scm/title": [
        {
          "command": "twigline.open",
          "when": "scmProvider == git",
          "group": "navigation"
        }
      ],
      "explorer/context": [
        {
          "command": "twigline.fileHistory",
          "when": "resourceScheme == file",
          "group": "7_twigline"
        }
      ],
      "editor/title/context": [
        {
          "command": "twigline.fileHistory",
          "when": "resourceScheme == file",
          "group": "7_twigline"
        }
      ],
      "view/item/context": [
        {
          "command": "twigline.open",
          "when": "view == twigline.repositories && viewItem == twigline.repository",
          "group": "inline"
        }
      ],
      "webview/context": [
        {
          "command": "twigline.commit.checkout",
          "when": "webviewId == 'twigline.repository' && webviewSection == 'commit'",
          "group": "1_checkout@1"
        },
        {
          "command": "twigline.commit.createBranch",
          "when": "webviewId == 'twigline.repository' && webviewSection == 'commit'",
          "group": "1_checkout@2"
        },
        {
          "command": "twigline.commit.createTag",
          "when": "webviewId == 'twigline.repository' && webviewSection == 'commit'",
          "group": "1_checkout@3"
        },
        {
          "command": "twigline.commit.merge",
          "when": "webviewId == 'twigline.repository' && webviewSection == 'commit' && !twiglineIsHead",
          "group": "2_integrate@1"
        },
        {
          "command": "twigline.commit.rebase",
          "when": "webviewId == 'twigline.repository' && webviewSection == 'commit' && !twiglineIsHead",
          "group": "2_integrate@2"
        },
        {
          "command": "twigline.commit.cherryPick",
          "when": "webviewId == 'twigline.repository' && webviewSection == 'commit' && !twiglineIsHead",
          "group": "2_integrate@3"
        },
        {
          "command": "twigline.commit.revert",
          "when": "webviewId == 'twigline.repository' && webviewSection == 'commit'",
          "group": "2_integrate@4"
        },
        {
          "command": "twigline.commit.reset",
          "when": "webviewId == 'twigline.repository' && webviewSection == 'commit' && !twiglineIsHead",
          "group": "3_rewrite@1"
        },
        {
          "command": "twigline.commit.interactiveRebase",
          "when": "webviewId == 'twigline.repository' && webviewSection == 'commit' && !twiglineIsHead",
          "group": "3_rewrite@2"
        },
        {
          "command": "twigline.commit.copySha",
          "when": "webviewId == 'twigline.repository' && webviewSection == 'commit'",
          "group": "4_copy@1"
        },
        {
          "command": "twigline.commit.copyMessage",
          "when": "webviewId == 'twigline.repository' && webviewSection == 'commit'",
          "group": "4_copy@2"
        },
        {
          "command": "twigline.commit.createPatch",
          "when": "webviewId == 'twigline.repository' && webviewSection == 'commit'",
          "group": "4_copy@3"
        },
        {
          "command": "twigline.commit.customAction",
          "when": "webviewId == 'twigline.repository' && webviewSection == 'commit'",
          "group": "4_copy@4"
        },
        {
          "command": "twigline.branch.checkout",
          "when": "webviewId == 'twigline.repository' && webviewSection == 'branch.local' && !twiglineIsHead",
          "group": "1_checkout@1"
        },
        {
          "command": "twigline.branch.createBranch",
          "when": "webviewId == 'twigline.repository' && webviewSection == 'branch.local'",
          "group": "1_checkout@2"
        },
        {
          "command": "twigline.branch.merge",
          "when": "webviewId == 'twigline.repository' && webviewSection == 'branch.local' && !twiglineIsHead",
          "group": "2_integrate@1"
        },
        {
          "command": "twigline.branch.rebase",
          "when": "webviewId == 'twigline.repository' && webviewSection == 'branch.local' && !twiglineIsHead",
          "group": "2_integrate@2"
        },
        {
          "command": "twigline.branch.pull",
          "when": "webviewId == 'twigline.repository' && webviewSection == 'branch.local'",
          "group": "3_remote@1"
        },
        {
          "command": "twigline.branch.push",
          "when": "webviewId == 'twigline.repository' && webviewSection == 'branch.local'",
          "group": "3_remote@2"
        },
        {
          "command": "twigline.branch.setUpstream",
          "when": "webviewId == 'twigline.repository' && webviewSection == 'branch.local'",
          "group": "3_remote@3"
        },
        {
          "command": "twigline.branch.compare",
          "when": "webviewId == 'twigline.repository' && webviewSection == 'branch.local' && !twiglineIsHead",
          "group": "4_manage@1"
        },
        {
          "command": "twigline.branch.rename",
          "when": "webviewId == 'twigline.repository' && webviewSection == 'branch.local'",
          "group": "4_manage@2"
        },
        {
          "command": "twigline.branch.delete",
          "when": "webviewId == 'twigline.repository' && webviewSection == 'branch.local' && !twiglineIsHead",
          "group": "4_manage@3"
        },
        {
          "command": "twigline.branch.openPullRequest",
          "when": "webviewId == 'twigline.repository' && webviewSection == 'branch.local' && twiglinePr",
          "group": "5_pr@1"
        },
        {
          "command": "twigline.branch.createPullRequest",
          "when": "webviewId == 'twigline.repository' && webviewSection == 'branch.local' && !twiglinePrOpen",
          "group": "5_pr@2"
        },
        {
          "command": "twigline.remoteBranch.checkout",
          "when": "webviewId == 'twigline.repository' && webviewSection == 'branch.remote'",
          "group": "1_checkout@1"
        },
        {
          "command": "twigline.remoteBranch.createBranch",
          "when": "webviewId == 'twigline.repository' && webviewSection == 'branch.remote'",
          "group": "1_checkout@2"
        },
        {
          "command": "twigline.remoteBranch.merge",
          "when": "webviewId == 'twigline.repository' && webviewSection == 'branch.remote'",
          "group": "2_integrate@1"
        },
        {
          "command": "twigline.remoteBranch.compare",
          "when": "webviewId == 'twigline.repository' && webviewSection == 'branch.remote'",
          "group": "2_integrate@2"
        },
        {
          "command": "twigline.remoteBranch.delete",
          "when": "webviewId == 'twigline.repository' && webviewSection == 'branch.remote'",
          "group": "3_manage@1"
        },
        {
          "command": "twigline.remoteBranch.openPullRequest",
          "when": "webviewId == 'twigline.repository' && webviewSection == 'branch.remote' && twiglinePr",
          "group": "4_pr@1"
        },
        {
          "command": "twigline.tag.checkout",
          "when": "webviewId == 'twigline.repository' && webviewSection == 'tag'",
          "group": "1_checkout@1"
        },
        {
          "command": "twigline.tag.createBranch",
          "when": "webviewId == 'twigline.repository' && webviewSection == 'tag'",
          "group": "1_checkout@2"
        },
        {
          "command": "twigline.tag.showDetails",
          "when": "webviewId == 'twigline.repository' && webviewSection == 'tag'",
          "group": "1_checkout@3"
        },
        {
          "command": "twigline.tag.push",
          "when": "webviewId == 'twigline.repository' && webviewSection == 'tag'",
          "group": "2_manage@1"
        },
        {
          "command": "twigline.tag.delete",
          "when": "webviewId == 'twigline.repository' && webviewSection == 'tag'",
          "group": "2_manage@2"
        },
        {
          "command": "twigline.stash.apply",
          "when": "webviewId == 'twigline.repository' && webviewSection == 'stash'",
          "group": "1_apply@1"
        },
        {
          "command": "twigline.stash.pop",
          "when": "webviewId == 'twigline.repository' && webviewSection == 'stash'",
          "group": "1_apply@2"
        },
        {
          "command": "twigline.stash.showDiff",
          "when": "webviewId == 'twigline.repository' && webviewSection == 'stash'",
          "group": "1_apply@3"
        },
        {
          "command": "twigline.stash.createBranch",
          "when": "webviewId == 'twigline.repository' && webviewSection == 'stash'",
          "group": "2_branch@1"
        },
        {
          "command": "twigline.stash.drop",
          "when": "webviewId == 'twigline.repository' && webviewSection == 'stash'",
          "group": "3_manage@1"
        },
        {
          "command": "twigline.file.stage",
          "when": "webviewId == 'twigline.repository' && webviewSection == 'file.unstaged'",
          "group": "1_stage@1"
        },
        {
          "command": "twigline.file.unstage",
          "when": "webviewId == 'twigline.repository' && webviewSection == 'file.staged'",
          "group": "1_stage@1"
        },
        {
          "command": "twigline.file.discard",
          "when": "webviewId == 'twigline.repository' && webviewSection == 'file.unstaged'",
          "group": "1_stage@2"
        },
        {
          "command": "twigline.file.ignore",
          "when": "webviewId == 'twigline.repository' && webviewSection == 'file.unstaged'",
          "group": "2_ignore@1"
        },
        {
          "command": "twigline.file.resolveCurrent",
          "when": "webviewId == 'twigline.repository' && webviewSection == 'file.conflicted'",
          "group": "1_resolve@1"
        },
        {
          "command": "twigline.file.resolveIncoming",
          "when": "webviewId == 'twigline.repository' && webviewSection == 'file.conflicted'",
          "group": "1_resolve@2"
        },
        {
          "command": "twigline.file.openMergeEditor",
          "when": "webviewId == 'twigline.repository' && webviewSection == 'file.conflicted'",
          "group": "2_merge@1"
        },
        {
          "command": "twigline.file.markResolved",
          "when": "webviewId == 'twigline.repository' && webviewSection == 'file.conflicted'",
          "group": "3_mark@1"
        },
        {
          "command": "twigline.file.markUnresolved",
          "when": "webviewId == 'twigline.repository' && webviewSection == 'file.conflicted'",
          "group": "3_mark@2"
        },
        {
          "command": "twigline.file.openDiff",
          "when": "webviewId == 'twigline.repository' && webviewSection =~ /^file\\.(unstaged|staged|commit)$/",
          "group": "3_open@1"
        },
        {
          "command": "twigline.file.open",
          "when": "webviewId == 'twigline.repository' && webviewSection =~ /^file\\.(unstaged|staged)$/",
          "group": "3_open@2"
        },
        {
          "command": "twigline.commitFile.openRevision",
          "when": "webviewId == 'twigline.repository' && webviewSection == 'file.commit'",
          "group": "3_open@2"
        },
        {
          "command": "twigline.commitFile.compareWorktree",
          "when": "webviewId == 'twigline.repository' && webviewSection == 'file.commit'",
          "group": "3_open@3"
        },
        {
          "command": "twigline.file.history",
          "when": "webviewId == 'twigline.repository' && webviewSection =~ /^file\\.(unstaged|staged|commit)$/",
          "group": "3_open@4"
        },
        {
          "command": "twigline.commitFile.restore",
          "when": "webviewId == 'twigline.repository' && webviewSection == 'file.commit'",
          "group": "4_restore@1"
        },
        {
          "command": "twigline.file.reveal",
          "when": "webviewId == 'twigline.repository' && webviewSection == 'file.unstaged'",
          "group": "4_reveal@1"
        },
        {
          "command": "twigline.file.copyPath",
          "when": "webviewId == 'twigline.repository' && webviewSection =~ /^file\\.(unstaged|staged|commit)$/",
          "group": "4_reveal@2"
        }
      ],
