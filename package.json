{
  "name": "twigline",
  "displayName": "%displayName%",
  "description": "%description%",
  "version": "0.5.0",
  "publisher": "ryota-abe",
  "license": "MIT",
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#0B2621",
    "theme": "dark"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ryota-abe/twigline.git"
  },
  "bugs": {
    "url": "https://github.com/ryota-abe/twigline/issues"
  },
  "homepage": "https://github.com/ryota-abe/twigline#readme",
  "keywords": [
    "git",
    "scm",
    "graph",
    "git graph",
    "history",
    "commit",
    "branch",
    "diff",
    "stage",
    "merge",
    "rebase",
    "stash",
    "pull request",
    "japanese"
  ],
  "private": true,
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "SCM Providers",
    "Other"
  ],
  "main": "./dist/extension.js",
  "l10n": "./l10n",
  "extensionKind": [
    "workspace"
  ],
  "extensionDependencies": [
    "vscode.git"
  ],
  "activationEvents": [
    "onWebviewPanel:twigline.repository",
    "onStartupFinished"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false
    },
    "virtualWorkspaces": false
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:host": "node scripts/build.mjs --host",
    "build:webview": "vite build --config webview/vite.config.mts",
    "watch": "node scripts/build.mjs --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p webview/tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:perf": "vitest run --config vitest.perf.config.mts",
    "test:integration": "node scripts/build.mjs && vscode-test",
    "test:all": "npm run typecheck && npm test && npm run test:integration",
    "dev:web": "node scripts/build.mjs && node dist/dev/devServer.js",
    "package": "node scripts/build.mjs --production && vsce package --no-dependencies"
  },
  "contributes": {
    "commands": [
