    "configuration": {
      "title": "Twigline",
      "properties": {
        "twigline.gitPath": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "markdownDescription": "%config.gitPath%"
        },
        "twigline.history.order": {
          "type": "string",
          "default": "date",
          "scope": "resource",
          "markdownDescription": "%config.history.order%",
          "enum": [
            "date",
            "topo"
          ],
          "enumDescriptions": [
            "%config.history.order.date%",
            "%config.history.order.topo%"
          ]
        },
        "twigline.history.branches": {
          "type": "string",
          "default": "all",
          "scope": "resource",
          "markdownDescription": "%config.history.branches%",
          "enum": [
            "all",
            "current"
          ]
        },
        "twigline.history.showRemoteBranches": {
          "type": "boolean",
          "default": true,
          "scope": "resource",
          "markdownDescription": "%config.history.showRemoteBranches%"
        },
        "twigline.history.showStashes": {
          "type": "boolean",
          "default": false,
          "scope": "resource",
          "markdownDescription": "%config.history.showStashes%"
        },
        "twigline.history.pageSize": {
          "type": "number",
          "default": 500,
          "scope": "window",
          "markdownDescription": "%config.history.pageSize%",
          "minimum": 50,
          "maximum": 10000
        },
        "twigline.history.dateFormat": {
          "type": "string",
          "default": "absolute",
          "scope": "window",
          "markdownDescription": "%config.history.dateFormat%"
        },
        "twigline.graph.colors": {
          "type": "array",
          "default": [
            "#2f6bd8",
            "#c0397f",
            "#c98410",
            "#2c9a58",
            "#7a4fd0",
            "#d0503a",
            "#1a93a8",
            "#8a8f1f"
          ],
          "scope": "window",
          "markdownDescription": "%config.graph.colors%",
          "items": {
            "type": "string"
          }
        },
        "twigline.fileStatus.layout": {
          "type": "string",
          "default": "split",
          "scope": "window",
          "markdownDescription": "%config.fileStatus.layout%",
          "enum": [
            "split",
            "single"
          ]
        },
        "twigline.fileStatus.view": {
          "type": "string",
          "default": "list",
          "scope": "window",
          "markdownDescription": "%config.fileStatus.view%",
          "enum": [
            "list",
            "tree"
          ]
        },
        "twigline.diff.contextLines": {
          "type": "number",
          "default": 3,
          "scope": "window",
          "markdownDescription": "%config.diff.contextLines%",
          "minimum": 0,
          "maximum": 25
        },
        "twigline.diff.ignoreWhitespace": {
          "type": "boolean",
          "default": false,
          "scope": "window",
          "markdownDescription": "%config.diff.ignoreWhitespace%"
        },
        "twigline.diff.maxLines": {
          "type": "number",
          "default": 5000,
          "scope": "window",
          "markdownDescription": "%config.diff.maxLines%",
          "minimum": 100
        },
        "twigline.diff.syntaxHighlight": {
          "type": "boolean",
          "default": true,
          "scope": "window",
          "markdownDescription": "%config.diff.syntaxHighlight%"
        },
        "twigline.autoRefresh": {
          "type": "boolean",
          "default": true,
          "scope": "resource",
          "markdownDescription": "%config.autoRefresh%"
        },
        "twigline.autoFetch.intervalMinutes": {
          "type": "number",
          "default": 10,
          "scope": "resource",
          "markdownDescription": "%config.autoFetch.intervalMinutes%",
          "minimum": 0
        },
        "twigline.push.forceMode": {
          "type": "string",
          "default": "withLease",
          "scope": "resource",
          "markdownDescription": "%config.push.forceMode%",
          "enum": [
            "withLease",
            "force"
          ]
        },
        "twigline.commit.rememberPushAfter": {
          "type": "boolean",
          "default": true,
          "scope": "resource",
          "markdownDescription": "%config.commit.rememberPushAfter%"
        },
        "twigline.pullRequests.enabled": {
          "type": "boolean",
          "default": true,
          "scope": "window",
          "markdownDescription": "%config.pullRequests.enabled%"
        },
        "twigline.avatars.enabled": {
          "type": "boolean",
          "default": false,
          "scope": "application",
          "markdownDescription": "%config.avatars.enabled%"
        },
        "twigline.customActions": {
          "type": "array",
          "default": [],
          "scope": "application",
          "markdownDescription": "%config.customActions%",
          "items": {
            "type": "object",
